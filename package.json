{
  "name": "birds-of-prey",
  "version": "0.1.0",
  "description": "Birds of Prey: a Minecraft Bedrock add-on and Java mod with eagles, falcons, hawks, owls and vultures, falconry and birdwatching gear",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "validate": "node tools/validate.mjs",
    "package": "node tools/package.mjs",
    "preview": "node tools/preview.mjs",
    "test": "node --test test/*.test.mjs",
    "all": "npm run build && npm run validate && npm test && npm run package",
    "site": "node tools/site.mjs",
    "test:server": "tools/bds-test.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@minecraft/server": "2.3.0",
    "@minecraft/server-ui": "^2.0.0",
    "fflate": "^0.8.2",
    "pngjs": "^7.0.0"
  }
}
